<sdf version="1.6">
    <model name="fridge">
        <static>true</static>
        <!-- Body of the fridge -->
        <link name="body">
            <pose>0 0 0.76 0 0 0</pose>
            <visual name="visual_body">
                <geometry>
                    <box>
                        <size>0.54 0.57 1.52</size>
                    </box>
                </geometry>
                <material>
                    <ambient>1 1 1 1</ambient> <!-- White color, fully opaque -->
                </material>
            </visual>
            <collision name="collision_body">
                <geometry>
                    <box>
                        <size>0.54 0.57 1.52</size>
                    </box>
                </geometry>
            </collision>
        </link>
    </model>
</sdf>
