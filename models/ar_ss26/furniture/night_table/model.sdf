<sdf version="1.6">
    <model name="night_table">
        <static>true</static>
        <!-- Body of the night table -->
        <link name="plate">
            <pose>0 0 0.25 0 0 0</pose>
            <visual name="visual_plate">
                <geometry>
                    <box>
                        <size>0.495 0.45 0.5</size>
                    </box>
                </geometry>
                <material>
                    <ambient>1 1 1 1</ambient> <!-- White color, fully opaque -->
                </material>
            </visual>
            <collision name="collision_plate">
                <geometry>
                    <box>
                        <size>0.495 0.45 0.5</size>
                    </box>
                </geometry>
            </collision>
        </link>
    </model>
</sdf>
