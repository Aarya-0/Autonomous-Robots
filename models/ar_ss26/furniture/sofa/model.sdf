<sdf version="1.6">
    <model name="sofa">
        <static>true</static>
        <!-- Back of the sofa -->
        <link name="back">
            <pose>-0.325 0 0.5125 0 0 0</pose>
            <visual name="visual_back">
                <geometry>
                    <box>
                        <size>0.2 1.77 0.275</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.2 0.2 0.2 1</ambient> <!-- Dark grey color -->
                </material>
            </visual>
            <collision name="collision_back">
                <geometry>
                    <box>
                        <size>0.2 1.77 0.275</size>
                    </box>
                </geometry>
            </collision>
        </link>

